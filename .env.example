# Resolve — environment variables
#
# On Vercel: project → Settings → Environment Variables, then redeploy.
# Locally:   copy this file to .env.local and fill in what you need.
#
# You need at least ONE AI key. Nothing else is required.

# ── AI provider ─────────────────────────────────────────────────────────────
# NVIDIA Build — free tier, open models (Llama 3.3 70B). https://build.nvidia.com
NVIDIA_API_KEY=

# Anthropic (Claude) — paid. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any other provider. Keys starting gsk_ (Groq), sk-or- (OpenRouter), AIza (Gemini)
# or xai- (xAI) are recognised automatically. For anything else also fill in
# AI_BASE_URL (e.g. https://api.together.xyz/v1) and AI_MODEL.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ── Optional AI settings ────────────────────────────────────────────────────
# Which provider to try first when several keys are set:
# AI_PROVIDER=nvidia            # or anthropic, openai, custom (or groq, openrouter… for AI_API_KEY)
# Model overrides (defaults shown):
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct   # used when a case has a photo
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o
# AI_VISION_MODEL=              # photo-capable model for AI_API_KEY, if different from AI_MODEL
# Label shown in messages for AI_API_KEY (e.g. Together AI):
# AI_PROVIDER_NAME=
# Total time allowed for one AI request, in milliseconds (default 52000):
# AI_TOTAL_TIMEOUT_MS=52000

# ── Sending to customers (OPTIONAL — off by default) ───────────────────────
# By default "Send to customer" opens the advisor's own email / WhatsApp / messages
# app with the reply filled in: free, no setup. Fill these in only if you want the
# platform to send email by itself (a "Send directly" button then appears).
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM=
